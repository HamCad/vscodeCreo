{
  "name": "vscodecreo",
  "displayName": "vscodeCreo",
  "description": "vscode extension to provide support for Creo config.pro and mapkeys.pro",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "pro",
        "aliases": [
          "Creo Pro",
          "pro"
        ],
        "extensions": [
          ".pro",
          ".sup"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pro",
        "scopeName": "source.pro",
        "path": "./syntaxes/pro.tmLanguage.json"
      }
    ]
  }
}
