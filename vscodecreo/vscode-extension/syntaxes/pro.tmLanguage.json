{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Creo Pro",
  "scopeName": "source.pro",

  "repository": {

    "comment": {
      "match": "#.*$",
      "name": "comment.line.number-sign.pro"
    },

    "keyword-mapkey": {
      "match": "\\bmapkey\\b",
      "name": "keyword.control.pro"
    },

    "directive": {
      "match": "@[A-Za-z0-9_\\-\\(\\):]+",
      "name": "keyword.other.directive.pro"
    },

    "identifier": {
      "match": "[A-Za-z0-9_\\-\\+]+(?:\\:[A-Za-z0-9_\\-]+)?",
      "name": "entity.name.function.pro"
    },

    "tilde": {
      "match": "~",
      "name": "punctuation.definition.command.pro"
    },

    "semicolon": {
      "match": ";",
      "name": "punctuation.terminator.statement.pro"
    },

    "backslash-eol": {
      "match": "\\\\\\r?\\n",
      "name": "constant.character.escape.line-continuation.pro"
    },

    "string-double": {
      "match": "\"(?:\\\\.|[^\"\\\\])*\"?",
      "name": "string.quoted.double.pro"
    },

    "string-single": {
      "match": "'(?:\\\\.|[^'\\\\])*'?",
      "name": "string.quoted.single.pro"
    },

    "argument": {
      "match": "[^~;\\\\\\r\\n]+",
      "name": "variable.parameter.pro"
    }
  },

  "patterns": [
    { "include": "#comment" },
    { "include": "#string-double" },
    { "include": "#string-single" },
    { "include": "#keyword-mapkey" },
    { "include": "#directive" },
    { "include": "#tilde" },
    { "include": "#semicolon" },
    { "include": "#backslash-eol" },
    { "include": "#identifier" },
    { "include": "#argument" }
  ]
}

